# این فایل فقط برای اجرای محلی است. در production همه مقادیر باید
# در Cloudflare Pages → Settings → Variables and Secrets ثبت شوند.
GITHUB_REPO=szarghami/sinazarghami.ir
GITHUB_BRANCH=main
SITE_URL=http://localhost:5173
GEMINI_MODEL=gemini-2.5-flash
# برای سرویس‌های جایگزین کلیدها را فقط به صورت Secret در Cloudflare قرار دهید.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# آروان کلاود — استوریج شیء (S3). کلیدها فقط در Cloudflare Pages (Secret) ثبت شوند.
ARVAN_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_S3_REGION=ir-thr-at1
ARVAN_S3_BUCKET=sinazarghamimedia
ARVAN_S3_ACCESS_KEY=
ARVAN_S3_SECRET_KEY=
ARVAN_PUBLIC_BASE=https://s3.ir-thr-at1.arvanstorage.ir/sinazarghamimedia
ARVAN_MEDIA_PREFIX=media
