# Copy to .dev.vars (ignored by Git) for local testing with `npx wrangler pages dev dist`.
ADMIN_INITIAL_PASSCODE=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
GITHUB_REPO=szarghami/sinazarghami.ir
GITHUB_BRANCH=main
SITE_URL=http://localhost:8788

# آروان کلاود — استوریج شیء (S3)
ARVAN_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_S3_REGION=ir-thr-at1
ARVAN_S3_BUCKET=sinazarghamimedia
ARVAN_S3_ACCESS_KEY=
ARVAN_S3_SECRET_KEY=
ARVAN_PUBLIC_BASE=https://s3.ir-thr-at1.arvanstorage.ir/sinazarghamimedia
ARVAN_MEDIA_PREFIX=media
